<odoo>
    <record model="ir.ui.view" id="vcp_user_form_view">
        <field name="model">vcp.user</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="external_id" />
                        <field name="host_id" />
                        <field name="partner_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_user_search_view">
        <field name="model">vcp.user</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="external_id" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_user_tree_view">
        <field name="model">vcp.user</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="external_id" />
                <field name="host_id" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_user_act_window">
        <field name="name">Users</field>
        <field name="res_model">vcp.user</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="vcp_user_menu">
        <field name="name">Users</field>
        <field name="parent_id" ref="vcp_settings_menu" />
        <field name="action" ref="vcp_user_act_window" />
        <field name="sequence" eval="20" />
    </record>
</odoo>
