<odoo>
    <record model="ir.ui.view" id="contributors_repository_form_view">
        <field name="model">contributors.repository</field>
        <field
            name="inherit_id"
            ref="contributors_github.contributors_repository_form_view"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="%(contributors_translation_repository_act_window)d"
                    type="action"
                    string="Translations"
                    class="oe_stat_button"
                    icon="fa-language"
                    invisible="not weblate_url"
                />
            </div>
        </field>
    </record>
</odoo>
