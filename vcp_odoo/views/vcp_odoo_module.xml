<odoo>
    <record model="ir.ui.view" id="vcp_odoo_module_form_view">
        <field name="model">vcp.odoo.module</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                    <notebook>
                        <page string="Versions">
                            <field name="version_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_odoo_module_search_view">
        <field name="model">vcp.odoo.module</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="vcp_odoo_module_tree_view">
        <field name="model">vcp.odoo.module</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="vcp_odoo_module_act_window">
        <field name="name">Odoo Modules</field>
        <field name="res_model">vcp.odoo.module</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="vcp_odoo_module_menu">
        <field name="name">Odoo Modules</field>
        <field name="parent_id" ref="vcp_management.vcp_main_menu" />
        <field name="action" ref="vcp_odoo_module_act_window" />
        <field name="sequence" eval="70" />
    </record>
</odoo>
