<odoo>
    <record model="ir.ui.view" id="contributors_review_form_view">
        <field name="model">contributors.review</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="github_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="contributors_review_tree_view">
        <field name="model">contributors.review</field>
        <field name="arch" type="xml">
            <list>
                <field name="github_id" />
            </list>
        </field>
    </record>
</odoo>
