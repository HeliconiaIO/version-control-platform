<odoo>
    <record model="ir.ui.view" id="contributors_organization_form_view">
        <field name="model">contributors.organization</field>
        <field
            name="inherit_id"
            ref="contributors_github.contributors_organization_form_view"
        />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="PSC">
                    <group>
                        <field name="psc_repository" />
                        <field name="psc_repository_conf" />
                        <field name="psc_ids" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
